<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>annotations</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <NoWarn>$(NoWarn);CA1416;CS0108</NoWarn>
        <PlaygroundArtifacts>$(MSBuildThisFileDirectory)..\artifacts\</PlaygroundArtifacts>
        <ArtifactsPath>$(PlaygroundArtifacts)build\pc\dotnet</ArtifactsPath>
        <ReactiveSrc>$(PlaygroundArtifacts)downloads\reactive-mono\src\</ReactiveSrc>
    </PropertyGroup>
</Project>
